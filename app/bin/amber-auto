#!/opt/software/amber_general_workflow/envs/analysis/bin/python
"""amber-auto: one-command Amber MD system building and cluster submission.

Typical use:
  amber-auto run complex1.pdb complex2.pdb
  amber-auto build complex1.pdb --no-submit
  amber-auto status --queue
  amber-auto report
  amber-auto resume

The tool inspects each complex, prepares protein/ligand coordinates, builds an
Amber topology with tleap, generates MD inputs, and submits an equil -> prod ->
post (cpptraj + analysis + MM-GBSA) Torque dependency chain. It reuses the
tested scripts in this repository and leaves the legacy amber-kit workflow
available for advanced use.
"""
import argparse
import copy
import csv
import datetime
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys


def _reexec_with_newer_python():
    """Re-exec under Python >= 3.7 when the shebang found an older python3.

    Some clusters put /usr/bin/python3 (3.6 on RHEL7) first in PATH while a
    newer interpreter lives in a conda install. Conda's PATH entry can contain
    a literal '~' (bash expands it, execvp in a shebang does not), so also
    expand PATH entries here.
    """
    if sys.version_info >= (3, 7):
        return
    versioned = ("python3.13", "python3.12", "python3.11", "python3.10",
                 "python3.9", "python3.8", "python3.7")
    candidates = []
    for name in versioned:
        exe = shutil.which(name)
        if exe:
            candidates.append(exe)
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        entry = os.path.expanduser(entry)
        if not entry:
            continue
        candidates.append(os.path.join(entry, "python3"))
        candidates += [os.path.join(entry, name) for name in versioned]
    candidates += [
        os.path.expanduser("~/Software/anaconda3/bin/python3"),
        os.path.expanduser("~/anaconda3/bin/python3"),
        "/opt/conda/bin/python3",
        "/usr/local/bin/python3",
    ]
    seen = {os.path.realpath(sys.executable)}
    script = os.path.abspath(__file__)
    for exe in candidates:
        if not (exe and os.access(exe, os.X_OK)):
            continue
        real = os.path.realpath(exe)
        if real in seen:
            continue
        seen.add(real)
        probe = subprocess.run(
            [exe, "-c",
             "import sys; raise SystemExit(0 if sys.version_info >= (3, 7) else 1)"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if probe.returncode == 0:
            os.execv(exe, [exe, script] + sys.argv[1:])
    sys.exit("amber-auto requires Python >= 3.7 (found %s); put a newer "
             "python3 in PATH" % sys.version.split()[0])


_reexec_with_newer_python()

KIT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SCRIPTS = os.path.join(KIT_DIR, "scripts")
PBS_DIR = os.path.join(KIT_DIR, "pbs")

