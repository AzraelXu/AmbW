# RNA-ligand system, generated by amber_general_workflow/scripts/build_system.sh
# Confirm: force field, ligand net charge/protonation, water, ions, box, radii.
source {{LEAPRC_RECEPTOR}}
source {{LEAPRC_GAFF}}
{{LEAPRC_WATER_BLOCK}}

loadAmberParams {{LIG_FRCMOD}}
{{LIG_VAR}} = loadMol2 {{LIG_MOL2}}
{{RECEPTOR_VAR}} = loadPdb {{RECEPTOR_PDB}}

com = combine { {{RECEPTOR_VAR}} {{LIG_VAR}} }
check com
charge com

{{SOLVATE_BLOCK}}
{{NEUTRALIZE_BLOCK}}
{{SALT_BLOCK}}
check com
charge com
desc com

set default PBRadii {{RADII}}
{{EXTRA_LEAP}}
saveAmberParm com {{TOP_NAME}}.prmtop {{TOP_NAME}}.inpcrd
quit
