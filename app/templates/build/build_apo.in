# Apo system (RNA or protein), generated by amber_general_workflow/scripts/build_system.sh
# Confirm: force field, water, ions, box, radii.
source {{LEAPRC_RECEPTOR}}
{{LEAPRC_WATER_BLOCK}}

{{RECEPTOR_VAR}} = loadPdb {{RECEPTOR_PDB}}
check {{RECEPTOR_VAR}}
charge {{RECEPTOR_VAR}}

{{SOLVATE_BLOCK}}
{{NEUTRALIZE_BLOCK}}
{{SALT_BLOCK}}
check {{RECEPTOR_VAR}}
charge {{RECEPTOR_VAR}}
desc {{RECEPTOR_VAR}}

set default PBRadii {{RADII}}
{{EXTRA_LEAP}}
saveAmberParm {{RECEPTOR_VAR}} {{TOP_NAME}}.prmtop {{TOP_NAME}}.inpcrd
quit
